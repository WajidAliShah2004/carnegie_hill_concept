# Cloudflare Pages response headers. Copied into out/ by the build.
#
# The rule that matters: HTML is never cached, hashed assets are cached for a
# year. The owner publishes a photo from his phone and expects to see it, so a
# cached HTML page is a bug, not a saving.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Every HTML page. Revalidate on every request.
/
  Cache-Control: public, max-age=0, must-revalidate
/*/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Generated text that changes with the content.
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

# RSC payloads follow the page they belong to.
/*.txt
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output. The file name changes when the contents change, so this
# can be cached for a year and never revalidated.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
