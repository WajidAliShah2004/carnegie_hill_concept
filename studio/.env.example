# Copy to .env and fill in once the Sanity project exists.
# Without these the Studio still builds, using a placeholder project id, but it
# cannot connect to Sanity and cannot be deployed.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# The name in <name>.sanity.studio. Used by `npm run deploy`.
SANITY_STUDIO_HOST=

# Comma separated. These accounts get the simple Photos only desk.
# See the limits of this in README.md.
SANITY_STUDIO_OWNER_EMAILS=
